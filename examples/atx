#!/bin/bash
# Cold-start a registered a-team agent without the TUI.
# `atx <agent>` opens it on whichever host it is registered to; `atx` lists.
#
# Why this exists: the a-team registry is the thing that knows an agent's folder,
# host and harness. The picker UI on top of it is optional. Once an agent is
# running on the server it is reachable from the phone (Remote Control) and from
# other sessions (SendMessage), so the only job left for the terminal is the
# COLD START: get the right session running, on the right machine, correctly named.
#
# Usage:
#   atx                 list registered agents
#   atx <agent>         attach to that agent's session, starting it if needed
#   atx <agent> -n      start an ADDITIONAL parallel session in the same folder
#   atx <agent> -n --label Acme
#                       ... and name it after the customer/topic, so the phone app
#                       shows "Name: Acme" instead of "Name 2"
#   atx <agent> -s N    attach to parallel session N (1 = the first one)
#   atx <agent> -d      start detached, do not attach (fire-and-forget)
#   atx <agent> -L      list this agent's running sessions
#   atx -l <agent>      show where it lives, start nothing
#
# Parallel sessions: an agent can have several chats open in the same folder.
# The first is the tmux session `<id>`, extras are `<id>-2`, `<id>-3`, ... and
# are named "<Name> 2", "<Name> 3" in the phone app so they stay tellable apart.
#
# Remote agents run inside tmux on their host, so they survive this terminal
# closing, and start with Remote Control on under the agent's own name.

set -euo pipefail

AT=$(command -v a-team) || { echo "a-team not found on PATH" >&2; exit 1; }

usage() { sed -n '3,20p' "$0" | sed 's/^# \{0,1\}//'; }

DETACH=0
WINDOW=0
LOOKUP=0
NEWSESS=0
LISTSESS=0
LABEL=""
PICK=""
AGENT=""
while [ $# -gt 0 ]; do
  case "$1" in
    -d|--detach) DETACH=1; shift ;;
    -w|--window) WINDOW=1; shift ;;
    -l|--where)  LOOKUP=1; shift ;;
    -n|--new)    NEWSESS=1; shift ;;
    --label)     LABEL="$2"; NEWSESS=1; shift 2 ;;
    -L|--list)   LISTSESS=1; shift ;;
    -s|--session) PICK="$2"; shift 2 ;;
    -h|--help)   usage; exit 0 ;;
    -*) echo "unknown option: $1" >&2; exit 1 ;;
    *) [ -z "$AGENT" ] && AGENT="$1"; shift ;;
  esac
done

if [ -z "$AGENT" ]; then
  "$AT" ls
  exit 0
fi

# One resolver, the registry. Never guess a path or a host here.
if ! JSON=$("$AT" resolve "$AGENT" --json 2>/dev/null) || [ "${JSON#\{}" = "$JSON" ]; then
  echo "no such agent: $AGENT" >&2
  echo "try: atx        (to list)" >&2
  exit 1
fi

field() { printf '%s' "$JSON" | sed -n "s/.*\"$1\": *\"\([^\"]*\)\".*/\1/p"; }

ID=$(field id)
NAME=$(field name)
PATH_=$(field path)
HOST=$(field host)
SSH_T=$(field ssh)
HARNESS=$(field harness)
[ -n "$HARNESS" ] || HARNESS=claude

if [ "$LOOKUP" -eq 1 ]; then
  printf '  %-10s %s\n' id "$ID" name "$NAME" host "${HOST:-local}" path "$PATH_" harness "$HARNESS"
  [ -n "$SSH_T" ] && printf '  %-10s %s\n' ssh "$SSH_T"
  exit 0
fi

# ---------------------------------------------------------------------------
# Local: just cd and run. You are already at this machine.
# ---------------------------------------------------------------------------
if [ -z "$SSH_T" ] || [ "${HOST:-local}" = "local" ]; then
  DIR="${PATH_/#\~/$HOME}"
  [ -d "$DIR" ] || { echo "folder missing on this machine: $DIR" >&2; exit 1; }

  # A label names the session even locally. Locally there is no tmux to attach
  # to (you are at the machine; each window holds one session), so the label's
  # job is identification: it titles the session and, for Claude, turns on
  # Remote Control under that name so the same customer session is reachable
  # from the phone later. Without a label, nothing changes.
  RC=""
  if [ -n "$LABEL" ] && [ "$HARNESS" = "claude" ]; then
    RC="--remote-control $(printf '%q' "$NAME: $LABEL")"
    echo "starting $NAME: $LABEL locally in $DIR"
  elif [ -n "$LABEL" ]; then
    echo "note: --label needs the claude harness to name a session; ignoring" >&2
    echo "starting $NAME locally in $DIR"
  else
    echo "starting $NAME locally in $DIR"
  fi
  cd "$DIR" && exec "$HARNESS" ${RC:+$RC}
fi

# ---------------------------------------------------------------------------
# Remote: tmux on that host, so it outlives this terminal.
#   --remote-control "<name>" => reachable from the phone and by SendMessage,
#   and named properly instead of the runtime's `hostname-ancient-wirth`.
# Codex has no Remote Control flag, so it is omitted for that harness.
# ---------------------------------------------------------------------------
# Which of this agent's sessions are running there? (`<id>`, `<id>-2`, ...)
# Keep the ssh separate from the filtering. Under `set -o pipefail` a grep that
# matches nothing makes the whole pipeline non-zero, which would report a
# perfectly reachable host as unreachable the moment an agent has no sessions.
RAW=$(ssh -o ConnectTimeout=10 "$SSH_T" \
  "PATH=/opt/homebrew/bin:\$PATH; tmux ls 2>/dev/null | cut -d: -f1") \
  || { echo "could not reach $HOST (ssh $SSH_T)" >&2; exit 1; }
EXISTING=$(printf '%s\n' "$RAW" | grep -E "^${ID}(-[a-z0-9][a-z0-9-]*)?$" | sort || true)

if [ "$LISTSESS" -eq 1 ]; then
  if [ -z "$EXISTING" ]; then echo "no running sessions for $NAME on $HOST"; else
    echo "$NAME sessions on $HOST:"
    i=1; for s in $EXISTING; do
      if [ "$s" = "$ID" ]; then echo "  $i. $s   (atx $AGENT)"
      else
        sfx="${s#${ID}-}"
        case "$sfx" in
          [0-9]*) echo "  $i. $s   (atx $AGENT -s $i)" ;;
          *)      echo "  $i. $s   (atx $AGENT --label $sfx)" ;;
        esac
      fi
      i=$((i+1))
    done
  fi
  exit 0
fi

# Choose the target session name.
if [ -n "$PICK" ]; then
  SESS=$(echo "$EXISTING" | sed -n "${PICK}p")
  [ -n "$SESS" ] || { echo "$NAME has no session $PICK (try: atx $AGENT -L)" >&2; exit 1; }
  RC_NAME="$NAME"; [ "$SESS" != "$ID" ] && RC_NAME="$NAME ${SESS##*-}"
elif [ -n "$LABEL" ]; then
  # Named session: one per customer/topic. Reuse it if it already exists, so
  # `atx <agent> --label Acme` is the way back into that customer's session
  # rather than a way to accumulate duplicates of it.
  SLUG=$(printf '%s' "$LABEL" | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '-' \
         | sed 's/--*/-/g; s/^-//; s/-$//')
  [ -n "$SLUG" ] || { echo "--label must contain letters or digits" >&2; exit 1; }
  SESS="${ID}-${SLUG}"; RC_NAME="$NAME: $LABEL"
elif [ "$NEWSESS" -eq 1 ]; then
  # Next free suffix, so a second chat never collides with the first.
  n=2
  while echo "$EXISTING" | grep -qx "${ID}-${n}"; do n=$((n+1)); done
  SESS="${ID}-${n}"; RC_NAME="$NAME $n"
else
  SESS="$ID"; RC_NAME="$NAME"
fi

RC=""
[ "$HARNESS" = "claude" ] && RC="--remote-control $(printf '%q' "$RC_NAME")"
REMOTE_CMD="cd $(printf '%q' "$PATH_") && $HARNESS $RC"

if echo "$EXISTING" | grep -qx "$SESS"; then
  echo "attaching to $RC_NAME on $HOST ($SESS)"
else
  echo "starting $RC_NAME on $HOST ($PATH_)"
  ssh -o ConnectTimeout=10 "$SSH_T" "PATH=/opt/homebrew/bin:\$PATH; \
tmux new-session -d -s $(printf '%q' "$SESS") -c $(printf '%q' "$PATH_") \
$(printf '%q' "PATH=/opt/homebrew/bin:\$PATH; $REMOTE_CMD")" \
    || { echo "could not start the session on $HOST" >&2; exit 1; }
fi

if [ "$DETACH" -eq 1 ]; then
  echo "running detached on $HOST. Reach it from:"
  echo "  the Claude phone app  ->  Code > Session list > \"$RC_NAME\""
  echo "  this terminal         ->  atx $AGENT${PICK:+ -s $PICK}"
  exit 0
fi

# A window of its own, rather than taking over this terminal. a-team already
# knows how to do this: it opens a window in the RUNNING Ghostty instance over
# AppleScript, because `open -na Ghostty --args -e` starts a SECOND instance and
# fragments your windows. Passing the tmux session name makes its
# `tmux new-session -A` attach to what is already running rather than duplicate it.
if [ "$WINDOW" -eq 1 ]; then
  ATEAM_PY=$(head -1 "$(command -v a-team 2>/dev/null)" 2>/dev/null | sed 's|^#!||')
  ATEAM_SRC="${ATEAM_SRC:-$HOME/code/a-team/src}"
  if [ ! -x "$ATEAM_PY" ] || [ ! -d "$ATEAM_SRC" ]; then
    echo "  -w needs a-team installed and its source at $ATEAM_SRC" >&2
    echo "  attaching here instead" >&2
  else
    PYTHONPATH="$ATEAM_SRC" "$ATEAM_PY" - "$RC_NAME" "$PATH_" "$HOST" "$SESS" <<'PYEOF'
import sys
from a_team import spawn
name, path, host, session = sys.argv[1:5]
spawn.open_agent(name, path, host=host, session=session, session_mode="continue")
print(f"  opened a window: {name}")
PYEOF
    echo "  empty window? run it again: the command is delivered by clipboard"
    echo "  paste and occasionally misses the window opening."
    exit 0
  fi
fi

# Attach. mosh survives flaky wifi and roaming; ssh is the fallback.
exec_attach="tmux attach -t $(printf '%q' "$SESS")"
if command -v mosh >/dev/null 2>&1; then
  mosh "$SSH_T" -- $exec_attach || ssh -t "$SSH_T" "$exec_attach"
else
  ssh -t "$SSH_T" "$exec_attach"
fi
